# Copy this file to .env and fill in your API key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Optional: let the AI use Google Search for fresher prices (slower, uses more quota)
GEMINI_GROUNDING=false

# Server port (Python FastAPI backend)
PORT=8000

# Set to true when deploying behind HTTPS (Render, Railway, Fly.io, custom domain)
COOKIE_SECURE=false

# Secret key for signing login JWT tokens (set a strong random string in production)
JWT_SECRET=change-this-to-a-random-secret-string

# Optional Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=

# AI calls allowed per IP per minute
RATE_LIMIT_PER_MIN=15
